{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.quotient.axion/schemas/meeting.lens_temporal.v1.json",
  "title": "LensTemporal",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "disposition"
      ],
      "properties": {
        "dimension": {
          "const": "temporal"
        },
        "disposition": {
          "const": "none_in_transcript"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "disposition",
        "findings"
      ],
      "properties": {
        "dimension": {
          "const": "temporal"
        },
        "disposition": {
          "const": "findings"
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statement",
              "stance",
              "claim_ids"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "stance": {
                "type": "string",
                "enum": [
                  "supports",
                  "conflicts",
                  "unknown"
                ]
              },
              "claim_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  ]
}
