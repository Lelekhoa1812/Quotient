{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.quotient.axion/schemas/meeting.digest.v1.json",
  "title": "Digest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_type",
    "title",
    "summary",
    "chapters",
    "decisions",
    "actions",
    "open_questions",
    "disagreements",
    "key_figures",
    "risks",
    "concepts",
    "diagram",
    "outcome",
    "speakers",
    "perspectives"
  ],
  "properties": {
    "content_type": {
      "type": "string",
      "enum": [
        "meeting",
        "presentation",
        "lecture",
        "discussion",
        "interview",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "summary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "span_ids",
          "claim_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "span_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "gist",
          "start_span_id",
          "end_span_id"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "gist": {
            "type": "string",
            "minLength": 1
          },
          "start_span_id": {
            "type": "string",
            "minLength": 1
          },
          "end_span_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "status",
          "decided_by",
          "span_ids",
          "claim_ids"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "agreed",
              "tentative",
              "deferred"
            ]
          },
          "decided_by": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "span_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "owner",
          "due",
          "agreed",
          "span_ids",
          "claim_ids",
          "action_id",
          "quote"
        ],
        "properties": {
          "task": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "due": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "agreed": {
            "type": "boolean"
          },
          "span_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "action_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "asked_by",
          "asked_span_id",
          "answered",
          "answer",
          "answer_span_id"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "asked_by": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "asked_span_id": {
            "type": "string",
            "minLength": 1
          },
          "answered": {
            "type": "boolean"
          },
          "answer": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "answer_span_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        }
      }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "positions"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "positions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "speaker",
                "position",
                "span_ids"
              ],
              "properties": {
                "speaker": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ]
                },
                "position": {
                  "type": "string",
                  "minLength": 1
                },
                "span_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "key_figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "what",
          "span_id"
        ],
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "span_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk",
          "span_ids",
          "claim_ids"
        ],
        "properties": {
          "risk": {
            "type": "string",
            "minLength": 1
          },
          "span_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term",
          "explanation",
          "span_ids",
          "claim_ids"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "span_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "diagram": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "title",
            "mermaid",
            "span_ids"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "flowchart",
                "sequence"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "mermaid": {
              "type": "string",
              "minLength": 1
            },
            "span_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "span_ids"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "span_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "role",
          "span_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "span_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "perspectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "speaker",
          "position",
          "span_ids"
        ],
        "properties": {
          "speaker": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "position": {
            "type": "string",
            "minLength": 1
          },
          "span_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
