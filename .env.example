# Copy to .env and replace every placeholder. .env is git-ignored; never commit it.
# scripts/start-local.sh refuses to start while any required name is empty.
# Keys are read by the worker; the model names and regions below are required by the start
# script but the worker pins its models in apps/worker/bedrock/limits.py.

# Analysis service key (Amazon Bedrock bearer token). Blank keeps an existing value in the UI.
AWS_BEDROCK_API_KEY=replace-me

# Review-sorting service key (optional; without it review order keeps the gate order).
JEV_TYPESAFE_API_KEY=replace-me

# Required by scripts/start-local.sh (presence only).
AWS_BEDROCK_TRANSCRIBE=amazon.nova-2-5-sonic
AWS_BEDROCK_TRANSCRIBE_REGION=ap-northeast-1
AWS_BEDROCK_MEETING=global.twelvelabs.pegasus-1-2-v1:0
AWS_BEDROCK_LLM=global.openai.gpt-6.1-sol
AWS_BEDROCK_SLM=global.openai.gpt-6-luna
