# Copy to .env and replace every placeholder. .env is git-ignored; never commit it.
# scripts/start-local.sh refuses to start while any required name is empty.
# Keys are read by the worker; the model names and regions below are required by the start
# script but the worker pins its models in apps/worker/bedrock/limits.py.

# Analysis service key (Amazon Bedrock bearer token). Blank keeps an existing value in the UI.
AWS_BEDROCK_API_KEY=replace-me

# Scoring service key (optional; orders the review queue and the walkaway's decisions, actions, figures and risks by importance; without it the original order is kept). TYPESAFE_API_KEY is accepted as an alias.
JEV_TYPESAFE_API_KEY=replace-me

# Required by scripts/start-local.sh (presence only).
AWS_BEDROCK_TRANSCRIBE=amazon.nova-2-5-sonic
AWS_BEDROCK_TRANSCRIBE_REGION=ap-northeast-1
AWS_BEDROCK_MEETING=global.twelvelabs.pegasus-1-2-v1:0
AWS_BEDROCK_LLM=global.openai.gpt-6.1-sol
AWS_BEDROCK_SLM=global.openai.gpt-6-luna

# Optional. Hugging Face token the diarizer uses on first run to download the speaker-separation models
# (build its environment first with scripts/setup-diarizer.sh).
# The account must have accepted the terms of pyannote/segmentation-3.0 and pyannote/speaker-diarization-3.1.
HF_TOKEN=replace-me

# Optional. Reference documents ("+ Context") are converted by Microsoft MarkItDown in its own venv:
# run scripts/setup-context.sh once. Override the interpreter or where converted Markdown is cached:
# QUOTIENT_CONTEXT_PYTHON=/path/to/python
# QUOTIENT_CONTEXT_CACHE_DIR=/path/to/cache
